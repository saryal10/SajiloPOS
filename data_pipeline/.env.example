# --- Data source: pick ONE -----------------------------------------------
# Option A: pull from the shop's backend API (recommended for automation).
#   SAJILO_API_URL=https://pos.example.com
#   SAJILO_API_KEY=sk_live_paste_your_key_here
#
# Option B: read a Room database file pulled off a device (offline-first friendly).
#   SAJILO_DB_PATH=./sajilo_pos_database.db
# If SAJILO_API_URL is set, API mode wins. Otherwise the DB file is used.

#SAJILO_API_URL=
#SAJILO_API_KEY=
#SAJILO_API_AUTH=bearer
#SAJILO_DB_PATH=./sajilo_pos_database.db

# How far back the API client asks for (days). Ignored in DB mode.
#SAJILO_API_SINCE_DAYS=365
# HTTP timeout per request, seconds.
#SAJILO_API_TIMEOUT_S=30

# --- Analysis knobs (mirror the Android app's AnalyticsEngine) ------------
#SAJILO_VELOCITY_WINDOW_DAYS=14
#SAJILO_RESTOCK_LEAD_DAYS=7
#SAJILO_WATCH_STOCK_LEVEL=10
#SAJILO_TOP_N=10
#SAJILO_WEEKLY_CHART_WEEKS=12
#SAJILO_CURRENCY=रू
