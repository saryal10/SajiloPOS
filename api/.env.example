# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- PostgreSQL (production) ---------------------------------------------
# Leave POSTGRES_DB empty to use a local SQLite file instead (dev/tests).
#POSTGRES_DB=sajilopos
#POSTGRES_USER=sajilopos
#POSTGRES_PASSWORD=sajilopos-secret
#POSTGRES_HOST=127.0.0.1
#POSTGRES_PORT=5432

# --- Rate limits (DRF throttle rates) --------------------------------------
#API_THROTTLE_ANON=100/day
#API_THROTTLE_USER=2000/day
#API_THROTTLE_INGEST=120/minute
#API_PAGE_SIZE=100
