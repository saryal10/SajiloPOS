<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash-free, edge-to-edge host theme. All real styling lives in Compose
         (see ui/theme/Theme.kt); this theme only avoids a white flash on cold start. -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/pos_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>